{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "bridge-review": {
      "description": "A2A bridge 只读 agent：审查/分析，禁止写操作与命令执行",
      "mode": "primary",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false,
        "apply_patch": false,
        "task": false,
        "webfetch": false,
        "websearch": false,
        "todowrite": false,
        "question": false
      },
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "doom_loop": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "todowrite": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": "deny",
        "question": "deny",
        "external_directory": "deny"
      }
    },
    "bridge-coding": {
      "description": "A2A bridge 编码 agent：允许代码编辑与命令执行",
      "mode": "primary",
      "tools": {
        "question": false
      },
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "bash": "allow",
        "task": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "doom_loop": "allow",
        "question": "deny",
        "external_directory": "allow"
      }
    }
  }
