{
  "openapi": "3.0.3",
  "info": { "title": "Store API", "version": "1.0.0" },
  "servers": [{ "url": "https://store.example.test" }],
  "paths": {
    "/items/{id}": {
      "get": {
        "operationId": "getItem",
        "summary": "Fetch one item",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "mode", "in": "query", "schema": { "type": "string", "enum": ["short", "full"] } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/items": {
      "post": {
        "operationId": "createItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name"],
                    "properties": { "name": { "type": "string" } }
                  },
                  { "type": "string" }
                ]
              }
            }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    },
    "/trees": {
      "post": {
        "operationId": "createTree",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Tree" }
            }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Tree": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "children": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Tree" }
          }
        }
      }
    }
  }
}
